# Base image: Debian Bookworm (Debian Trixie also verified to work)
# uv provisions standalone Python 3.9 into the virtual environment for pycoral compatibility
FROM debian:bookworm-slim

# Install system dependencies for Edge TPU, OpenCV, Git, and video handling
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        git \
        gnupg \
        ca-certificates \
        ffmpeg \
        libsm6 \
        libxext6 \
        libgl1 \
        sudo && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /etc/apt/keyrings/coral-edgetpu.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/coral-edgetpu.gpg] https://packages.cloud.google.com/apt coral-edgetpu-stable main" | tee /etc/apt/sources.list.d/coral-edgetpu.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends libedgetpu1-std && \
    rm -rf /var/lib/apt/lists/*

# Install uv binary (pinned for reproducible builds)
COPY --from=ghcr.io/astral-sh/uv:0.5.29 /uv /uvx /bin/

ARG USERNAME=user
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# Create user with sudo, plugdev (for TPU devices) and video access
RUN groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID -m $USERNAME && \
    echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME && \
    chmod 0440 /etc/sudoers.d/$USERNAME && \
    usermod -aG plugdev,video $USERNAME && \
    mkdir -p /etc/udev/rules.d && \
    echo 'SUBSYSTEM=="usb", ATTRS{idVendor}=="1a6e", MODE="0666", GROUP="plugdev"' > /etc/udev/rules.d/99-edgetpu-accelerator.rules && \
    echo 'SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", MODE="0666", GROUP="plugdev"' >> /etc/udev/rules.d/99-edgetpu-accelerator.rules


USER $USERNAME
WORKDIR /workspaces/pigeon

# Point uv to a Python 3.9 virtual environment in the user's home directory and add it to PATH
ENV VIRTUAL_ENV="/home/$USERNAME/.venv"
ENV UV_PROJECT_ENVIRONMENT="/home/$USERNAME/.venv"
ENV UV_PYTHON="3.9"
ENV PATH="/home/$USERNAME/.venv/bin:$PATH"

# Install standalone Python 3.9 via uv, initialize venv, and link python binaries
RUN uv python install 3.9 && \
    uv venv $VIRTUAL_ENV --python 3.9 && \
    sudo ln -sf $VIRTUAL_ENV/bin/python /usr/local/bin/python && \
    sudo ln -sf $VIRTUAL_ENV/bin/python3 /usr/local/bin/python3

# Sync dependencies from lockfile using Python 3.9
COPY --chown=$USERNAME:$USERNAME pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --extra coral
