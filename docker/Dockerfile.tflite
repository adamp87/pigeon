FROM python:3.12-bookworm

# Install system dependencies for OpenCV, Git, and video handling
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
        ffmpeg \
        libsm6 \
        libxext6 \
        libgl1 \
        sudo && \
    rm -rf /var/lib/apt/lists/*

# Install uv for fast Python package management (pinned for reproducible builds)
COPY --from=ghcr.io/astral-sh/uv:0.5.29 /uv /uvx /bin/

ARG USERNAME=user
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# Create user with sudo access
RUN groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID -m $USERNAME && \
    echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME && \
    chmod 0440 /etc/sudoers.d/$USERNAME && \
    usermod -aG video $USERNAME

USER $USERNAME
WORKDIR /workspaces/pigeon

# Point uv to a virtual environment in the user's home directory and add it to PATH
ENV VIRTUAL_ENV="/home/$USERNAME/.venv"
ENV UV_PROJECT_ENVIRONMENT="/home/$USERNAME/.venv"
ENV PATH="/home/$USERNAME/.venv/bin:$PATH"

# Initialize venv and sync dependencies from lockfile
COPY --chown=$USERNAME:$USERNAME pyproject.toml uv.lock ./
RUN uv venv $VIRTUAL_ENV && \
    uv sync --frozen --no-install-project --extra tflite
